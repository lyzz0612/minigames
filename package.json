{
  "name": "pixi-mini-game-demo",
  "version": "1.0.0",
  "description": "Pixi v8 + adapter mini game framework demo for WeChat / Douyin / H5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/build.mjs all",
    "build:h5": "node scripts/build.mjs h5",
    "build:wechat": "node scripts/build.mjs wechat",
    "build:douyin": "node scripts/build.mjs douyin",
    "preview": "vite preview --outDir dist/h5",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "format": "prettier --write \"src/**/*.ts\"",
    "gen:audio": "node scripts/gen-audio.mjs"
  },
  "keywords": [
    "game",
    "framework",
    "mini-game",
    "pixi",
    "pixi8",
    "wechat",
    "douyin",
    "html5-game"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "@pixi/ui": "^2.4.1",
    "pixi.js": "^8.23.0"
  }
}
